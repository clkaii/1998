<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>1998 財富人生互動觀測站</title>
    <style>
        :root {
            --primary: #e67e22;
            --secondary: #34495e;
            --bg: #f8f9fa;
            --card: #ffffff;
            --text: #2c3e50;
        }

        * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; touch-action: manipulation; }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            background-color: var(--bg);
            color: var(--text);
            margin: 0;
            padding: 15px;
            display: flex;
            justify-content: center;
            min-height: 100vh;
        }

        .container {
            width: 100%;
            max-width: 480px;
            background: var(--card);
            padding: 25px;
            border-radius: 20px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.08);
            align-self: center;
        }

        .header { text-align: center; margin-bottom: 20px; }
        .header h1 { color: var(--primary); font-size: 1.5rem; margin: 0; }

        .step { display: none; }
        .step.active { display: block; animation: fadeIn 0.3s ease-in; }

        @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }

        .input-group { margin-bottom: 15px; }
        .input-group label { display: block; margin-bottom: 5px; font-weight: bold; font-size: 0.9rem; }
        .input-group input {
            width: 100%;
            padding: 12px;
            border: 1px solid #ddd;
            border-radius: 10px;
            font-size: 16px; /* 防止 iOS 縮放 */
        }

        .btn-next {
            width: 100%;
            background: var(--primary);
            color: white;
            padding: 15px;
            border: none;
            border-radius: 12px;
            font-size: 1rem;
            font-weight: bold;
            cursor: pointer;
            margin-top: 10px;
        }

        .btn-next:disabled { background: #ccc; }

        .summary-table {
            width: 100%;
            border-collapse: collapse;
            margin: 15px 0;
            font-size: 0.85rem;
        }

        .summary-table th, .summary-table td {
            padding: 10px;
            border: 1px solid #eee;
            text-align: left;
        }

        .summary-table th { background: #fdf2e9; color: var(--secondary); }

        .result-box {
            text-align: center;
            padding: 20px;
            background: #fdf2e9;
            border-radius: 15px;
            margin-bottom: 20px;
        }

        .footer {
            margin-top: 20px;
            text-align: center;
            font-size: 0.75rem;
            color: #999;
            border-top: 1px solid #eee;
            padding-top: 15px;
        }
    </style>
</head>
<body>

<div class="container">
    <div class="header">
        <h1>1998 財富人生</h1>
    </div>

    <!-- 步驟 0：身分驗證 -->
    <div class="step active" id="step0">
        <p style="text-align: center; color: #666; margin-bottom: 20px;">請先完成身分標記以產出整理表</p>
        <div class="input-group">
            <label>所屬通訊處</label>
            <input type="text" id="unitName" placeholder="例如：凱基通訊處" oninput="validate()">
        </div>
        <div class="input-group">
            <label>填寫人姓名</label>
            <input type="text" id="userName" placeholder="請輸入您的姓名" oninput="validate()">
        </div>
        <button class="btn-next" id="startBtn" onclick="toStep(1)" disabled>開始試算</button>
    </div>

    <!-- 步驟 1：互動簡述 (範例) -->
    <div class="step" id="step1">
        <div class="result-box">
            <p id="identTag" style="font-weight: bold; color: var(--secondary);"></p>
            <h2 style="color: var(--primary); margin: 10px 0;">您的財富清單</h2>
        </div>
        <table class="summary-table">
            <thead>
                <tr><th>項目</th><th>預計支出 (萬)</th></tr>
            </thead>
            <tbody id="tableBody">
                <!-- 這裡可以根據您之前的邏輯動態生成內容 -->
                <tr><td>一輩子總收入</td><td>1,998</td></tr>
                <tr><td>基本生活費 (30年)</td><td>540</td></tr>
                <tr><td>購屋預算</td><td>1,500</td></tr>
            </tbody>
        </table>
        <button class="btn-next" onclick="location.reload()">重新填寫</button>
        <div class="footer">
            企劃製作：KGI Life 組織發展團隊
        </div>
    </div>
</div>

<script>
    function validate() {
        const u = document.getElementById('unitName').value.trim();
        const n = document.getElementById('userName').value.trim();
        document.getElementById('startBtn').disabled = !(u && n);
    }

    function toStep(s) {
        if(s === 1) {
            const u = document.getElementById('unitName').value;
            const n = document.getElementById('userName').value;
            document.getElementById('identTag').innerText = u + " / " + n;
        }
        document.querySelectorAll('.step').forEach(el => el.classList.remove('active'));
        document.getElementById('step' + s).classList.add('active');
    }
</script>

</body>
</html>
